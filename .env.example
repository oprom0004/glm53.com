# app
NEXT_PUBLIC_APP_URL = "https://wanai30.com"
NEXT_PUBLIC_APP_NAME = "WanAI 3.0"

# theme
NEXT_PUBLIC_THEME = "default"

# First visits use dark mode; the theme switch remembers the visitor's choice.

# database
DATABASE_PROVIDER = "postgresql"
# Set the WanAI database connection string in .env.local; never use lipsync's database.
DATABASE_URL = ""
DB_SCHEMA_FILE = "./src/config/db/schema.postgres.ts"
DB_SCHEMA = "public"
DB_MIGRATIONS_OUT = "./src/config/db/migrations-postgres"
DB_MIGRATIONS_SCHEMA = "drizzle"
DB_MIGRATIONS_TABLE = "__drizzle_migrations"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""
